{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundCloud Mod",
  "version": "1.3.1",
  "identifier": "com.lazerprook1.soundcloudmod",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundCloud Mod",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 470,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMDM5RkYzOEUwNTAwMjgKUldRb0FBV084NThEY2lEaW94ZkQ4WlUyOW5nWXRZSFVPSmwxTE9WN0V5cmN5VTc3UWZzT1l2ejUK",
      "endpoints": [
        "https://github.com/LazerProOk1/soundcloud_mod/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "LazerProOk1",
    "copyright": "© 2026 LazerProOk1",
    "category": "Music",
    "shortDescription": "Native Liquid Glass SoundCloud client with Rust audio engine",
    "longDescription": "SoundCloud Mod is a native desktop client for SoundCloud featuring a custom Rust audio engine, 10-band EQ, local track caching, synchronized lyrics, SoundWave discovery, free Star auras, and Discord Rich Presence.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libasound2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "compression": "lzma",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
